<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE gui SYSTEM "kpartgui.dtd">
<gui name="io.github.arran4.kjules" version="1">
  <MenuBar>
    <Menu name="file"><text>&amp;File</text>
      <Action name="close_window"/>
    </Menu>
    <Menu name="job"><text>&amp;Job</text>
      <Action name="launch_new_attempt"/>
      <Action name="launch_variant"/>
      <Action name="retry_attempt"/>
      <Action name="new_job_from"/>
      <Separator/>
      <Action name="choose_winner"/>
      <Separator/>
      <Action name="refresh_session"/>
      <Action name="duplicate_session"/>
      <Action name="save_template"/>
      <Separator/>
      <Action name="watch_session"/>
      <Action name="archive_job"/>
      <Action name="delete_job"/>
    </Menu>
    <Menu name="links"><text>&amp;Links</text>
      <Action name="open_jules"/>
      <Action name="copy_jules"/>
      <Separator/>
      <Action name="open_pr"/>
      <Action name="copy_pr"/>
      <Action name="open_branch"/>
      <Action name="copy_branch"/>
    </Menu>
  </MenuBar>
  <ToolBar name="mainToolBar"><text>Main Toolbar</text>
    <Action name="refresh_session"/>
    <Action name="duplicate_session"/>
    <Separator/>
    <Action name="close_window"/>
  </ToolBar>
</gui>
